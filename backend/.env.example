# Copy this file to .env and fill in real values before running the app.
# See README.md for a full setup walkthrough.

# --- Database (PostgreSQL) ---------------------------------------------------
# Use "localhost" when running the app directly (npm run start:dev).
# Use "postgres" (the docker-compose service name) instead of "localhost"
# when running via `docker compose up` — the container can't reach the
# host's localhost, but can resolve other compose services by name.
DB_HOST=localhost
DB_PORT=5432
DB_USER=ifric
DB_PASSWORD=ifric
DB_NAME=ifric_registry_service
# Optional — enables TLS on the connection to Postgres. Off by default
# (unset or anything other than "true" keeps today's plaintext connection
# exactly as-is). Client-side only — does not turn on TLS on the bundled
# docker-compose/Helm Postgres, which has no TLS listener regardless.
DB_SSL=
# Only used when DB_SSL=true. Defaults to true (verifies the server's
# certificate) — only set "false" for self-signed certs you can't supply
# DB_SSL_CA for (not recommended outside local dev).
DB_SSL_REJECT_UNAUTHORIZED=
# Only used when DB_SSL=true. Optional PEM contents of a custom/private CA
# certificate, for a self-signed or private-CA Postgres instance.
DB_SSL_CA=

# --- Server -------------------------------------------------------------
PORT=4007
# Comma-separated list of origins allowed to call this API from a browser.
CORS_ORIGIN=http://localhost:3000

# --- Keycloak (required external identity provider) -------------------------
# This app has no built-in auth of its own — Keycloak is the sole identity
# provider for login, token refresh, logout, and every guarded route, and
# also owns all password/user-lifecycle management (create/change/recover/
# delete) via its Admin API. The app fails fast at startup if any of these
# are missing.
#
# Requires two clients to already exist in the target realm (one-time manual
# setup via the Keycloak admin console — see README.md for the walkthrough;
# this app does not create them for you):
#   1. A confidential client named "ifric" with Direct Access Grants (ROPC)
#      enabled — authenticates end users.
#   2. A confidential client named "ifric-admin" with its service account
#      enabled and granted the realm-management client's "manage-users"
#      role — used for user create/password-reset/delete via the Admin API.
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_CLIENT_SECRET=
# Optional — default to "ifric"/"ifric-admin" if unset.
KEYCLOAK_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_ID=

# --- ICID (company identity + certificate service) --------------------------
# Required. Base URL of an ICID-compatible service: it mints this platform's
# company_ifric_id identifiers and issues/verifies Hedera-based company
# certificates. ICID is a separate open-source project — see README.md.
ICID_SERVICE_BACKEND_URL=http://localhost:4100

# Optional. Local AES-256 key used to encrypt the private key ICID returns
# before it's stored in the database. Leave unset to run without the certificate
# feature entirely — the /certificate/* endpoints are not registered at all
# in that case (not just non-functional), and the app boots fine either way.
# Set this to enable them. Generate one with: openssl rand -hex 32
HEDERA_KEY_SECRET=

# Dash-separated dataspace/object-type/object-subtype code sent to ICID when
# minting a new company_ifric_id: <dataspace_code>-<object_type_code>-<object_sub_type_code>.
# The middle and last segments must exactly match an object type/subtype pair
# already seeded in the connected ICID instance (ICID's own POST /script seeds
# object_type "COM" with subtype "NAP" for companies) — verified against
# https://github.com/IndustryFusion/icidservice. object_type_code is compared
# case-sensitively on ICID's side, so it must be uppercase. See README.md.
COMPANY_DEFAULT_CODE=IFX-COM-NAP

# --- Company creation (placeholder gate) -------------------------------------
# Required. Shared secret checked against the X-API-Key header on
# POST /company/create-company — that endpoint has no Keycloak-token guard,
# since company creation is meant to be called by an external system before
# any of its users have Keycloak accounts. This is a stand-in for a real
# external-API-token flow to be built later — generate one with:
# openssl rand -hex 32
COMPANY_CREATION_API_KEY=
